# Optional. Without it the dashboard uses the template brief.
ANTHROPIC_API_KEY=
BRIEF_MODEL=claude-haiku-5-5
# Optional. Comma-separated origins allowed to call the API from a browser (a separately hosted front end).
# Empty means same-origin only.
ALLOWED_ORIGINS=
# Optional. Live mode; without them the committed snapshot is used.
SPACETRACK_USER=
SPACETRACK_PASS=
